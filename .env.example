# Copy to .env and fill in real values. Never commit the real .env file.
# chmod 600 .env in production.

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=fieldvibe
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand
POSTGRES_DB=fieldvibe

# Used by the backend container (service name "postgres" inside compose network)
DATABASE_URL=postgresql+asyncpg://fieldvibe:changeme-generate-with-openssl-rand@postgres:5432/fieldvibe
DATABASE_URL_SYNC=postgresql+psycopg2://fieldvibe:changeme-generate-with-openssl-rand@postgres:5432/fieldvibe

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme-generate-with-openssl-rand
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
IMPERSONATION_TOKEN_EXPIRE_MINUTES=60

# App-seitige Verschluesselung von mandant_integrationen.secret_ref (Fernet).
# Kein Ersatz fuer echtes Vault/KMS, aber besser als Klartext. In Produktion
# einen eigenen Wert setzen (nicht mit JWT_SECRET identisch).
# Generate with: openssl rand -base64 48
INTEGRATION_SECRET_KEY=changeme-generate-with-openssl-rand

# --- Kartenansicht (Modul "karten"), siehe docs/DEPLOYMENT.md ------------
# Ein einzelner Mapbox "default public token" (pk...) reicht fuer beides:
# Backend-Geocoding (MAPBOX_ACCESS_TOKEN) und Kartenrendering im Frontend
# (VITE_MAPBOX_TOKEN) -- leer lassen, um das Modul faktisch deaktiviert zu
# lassen (kein Fehler, es wird nur nicht geocodiert/gerendert).
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_TOKEN=

# --- Kundenportal Passwort-Reset ----------------------------------------
# Basis-URL des Frontends fuer den Reset-Link in der Mail.
# Lokal: http://localhost:5173. Produktiv: https://<DOMAIN_APP>.
FRONTEND_BASE_URL=http://localhost:5173
KUNDENPORTAL_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS -----------------------------------------------------------------
# Comma-separated list is not supported by pydantic-settings list parsing via
# env directly; use a JSON array string, e.g. '["https://app.example.de"]'
CORS_ORIGINS=["http://localhost:5173"]

# --- Objektspeicher (MinIO), siehe Abschnitt 2 & 15.4 ---------------------
MINIO_ROOT_USER=fieldvibe
MINIO_ROOT_PASSWORD=changeme-generate-with-openssl-rand
# Server-zu-server (Docker-Netzwerk-Hostname); NICHT das, was der Browser
# aufruft -- siehe S3_PUBLIC_URL_BASE.
S3_ENDPOINT_URL=http://minio:9000
# Muss vom Browser erreichbar sein (presigned URLs). Lokal: localhost:9000.
# Produktiv: https://<DOMAIN_S3 unten>, siehe docs/DEPLOYMENT.md.
S3_PUBLIC_URL_BASE=http://localhost:9000
S3_BUCKET_FOTOS=fieldvibe-fotos

# --- Produktions-Deployment (Abschnitt 15), siehe docs/DEPLOYMENT.md ------
# Nur relevant zusammen mit docker-compose.prod.yml (Caddy-Reverse-Proxy).
# Drei Subdomains auf denselben Server zeigen lassen (DNS A-Records), dann
# hier eintragen -- Caddy holt automatisch Let's-Encrypt-Zertifikate dafür.
DOMAIN_APP=app.example.de
DOMAIN_API=api.example.de
DOMAIN_S3=s3.example.de
# Für Let's-Encrypt-Benachrichtigungen (Ablauf-/Fehlerwarnungen), nicht
# öffentlich sichtbar.
CADDY_EMAIL=admin@example.de

# --- Backups (scripts/backup.sh, per Host-Cron) --------------------------
BACKUP_DIR=/opt/fieldvibe-backups
BACKUP_RETENTION_DAYS=14
# Optional, aber dringend empfohlen (Art. 32 DSGVO): Key-ID/E-Mail eines
# OFFLINE aufbewahrten oeffentlichen GPG-Schluessels, mit dem Backups vor
# dem Ablegen verschluesselt werden. Ohne diesen Wert bleiben Backups (mit
# allen Kunden-/Rechnungsdaten) unverschluesselt auf der Platte liegen.
# BACKUP_GPG_RECIPIENT=backup@example.de
# Optional: rclone-Remote-Pfad fuer eine automatische Offsite-Kopie nach
# jedem Backup-Lauf (vorher einmalig mit "rclone config" einrichten).
# Ohne diesen Wert liegen Backups nur auf diesem einen Server.
# BACKUP_OFFSITE_REMOTE=hetzner-storagebox:fieldvibe-backups

# --- Seed data (local dev only, see backend/app/seed.py) -----------------
SEED_SUPER_ADMIN_EMAIL=superadmin@fieldvibe.example.de
SEED_SUPER_ADMIN_PASSWORD=changeme
SEED_USER_PASSWORD=changeme

# --- Frontend ---------------------------------------------------------
# Wie der BROWSER das Backend erreicht (wird zur Build-Zeit ins JS-Bundle
# gebacken). Lokal: http://localhost:8000. Produktiv: https://<DOMAIN_API>.
VITE_API_BASE_URL=http://localhost:8000

# --- Environment ---------------------------------------------------------
ENVIRONMENT=development
