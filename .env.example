# Copy to .env and fill in real values. Never commit the real .env file.
# chmod 600 .env in production.

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=fieldvibe
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand
POSTGRES_DB=fieldvibe

# POSTGRES_USER ist im postgres-Image der Bootstrap-Superuser (umgeht RLS) und
# dient nur als Admin-Zugang. Backend, Worker und Alembic verbinden sich als
# eigene App-Rolle (NOSUPERUSER NOBYPASSRLS), die scripts/app_rolle_einrichten.sh
# bzw. scripts/deploy.sh anlegt: Passwort wird dort zufaellig erzeugt und samt
# DATABASE_URL/DATABASE_URL_SYNC in diese Datei geschrieben. Lokal (Compose-
# Override) legt scripts/docker-initdb-app-rolle.sh sie beim ersten Start an.
APP_DB_USER=fieldvibe_app
APP_DB_PASSWORD=changeme-generate-with-openssl-rand

# Used by the backend container (service name "postgres" inside compose network)
DATABASE_URL=postgresql+asyncpg://fieldvibe_app:changeme-generate-with-openssl-rand@postgres:5432/fieldvibe
DATABASE_URL_SYNC=postgresql+psycopg2://fieldvibe_app:changeme-generate-with-openssl-rand@postgres:5432/fieldvibe

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme-generate-with-openssl-rand
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
IMPERSONATION_TOKEN_EXPIRE_MINUTES=60

# App-seitige Verschluesselung von mandant_integrationen.secret_ref (Fernet).
# Kein Ersatz fuer echtes Vault/KMS, aber besser als Klartext. In Produktion
# einen eigenen Wert setzen (nicht mit JWT_SECRET identisch).
# Generate with: openssl rand -base64 48
INTEGRATION_SECRET_KEY=changeme-generate-with-openssl-rand

# --- Globaler Plattform-Mailversand (Fallback ohne Mandanten-SMTP) ------
# Greift automatisch, solange ein Mandant keine eigene smtp-Integration
# hinterlegt hat (siehe /integrationen im Frontend) -- sonst kaeme vor der
# ersten eigenen SMTP-Konfiguration gar keine Mail raus (Einladungen,
# Passwort-Reset). Eigene smtp-Integration eines Mandanten hat immer
# Vorrang, kein Umschalten noetig. Ohne Konfiguration hier UND ohne
# Mandanten-SMTP kommt der Registrierungs-/Reset-Link stattdessen direkt
# in der jeweiligen API-Antwort zurueck.
GLOBAL_SMTP_HOST=
GLOBAL_SMTP_PORT=587
GLOBAL_SMTP_USER=
GLOBAL_SMTP_PASSWORD=
# "account@..." statt z.B. "einladung@...", weil dieselbe Adresse auch
# fuer Passwort-Reset-Mails verwendet wird, nicht nur fuer Einladungen.
GLOBAL_SMTP_FROM_ADDRESS=account@fieldvibe.de

# --- Kartenansicht (Modul "karten"), siehe docs/DEPLOYMENT.md ------------
# Ein einzelner Mapbox "default public token" (pk...) reicht fuer beides:
# Backend-Geocoding (MAPBOX_ACCESS_TOKEN) und Kartenrendering im Frontend
# (VITE_MAPBOX_TOKEN) -- leer lassen, um das Modul faktisch deaktiviert zu
# lassen (kein Fehler, es wird nur nicht geocodiert/gerendert).
MAPBOX_ACCESS_TOKEN=
VITE_MAPBOX_TOKEN=

# --- Kundenportal Passwort-Reset ----------------------------------------
# Basis-URL des Frontends fuer den Reset-Link in der Mail.
# Lokal: http://localhost:5173. Produktiv: https://<DOMAIN_APP>.
FRONTEND_BASE_URL=http://localhost:5173
KUNDENPORTAL_RESET_TOKEN_EXPIRE_MINUTES=30
# Gueltigkeit des "Passwort vergessen"-Links fuer Mitarbeiter-Accounts.
USER_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS -----------------------------------------------------------------
# Comma-separated list is not supported by pydantic-settings list parsing via
# env directly; use a JSON array string. Produktiv gehören BEIDE Frontend-
# Subdomains hinein (Handy + Desktop teilen sich dasselbe Backend), z. B.
# '["https://app.example.de","https://office.example.de"]'
CORS_ORIGINS=["http://localhost:5173"]

# --- Refresh-Cookie (HttpOnly) -------------------------------------------------
# Das Refresh-Token der Mitarbeiter liegt als HttpOnly-/SameSite=Strict-Cookie
# am API-Host (Path=/api/auth), nicht mehr im Browser-Speicher. Secure ist
# ausser in Dev/Test an; nur im IP-Betrieb ohne TLS aus (docker-compose.ip.yml
# setzt das selbst).
# FIELDVIBE_REFRESH_COOKIE_SECURE=1
# Uebergangsfrist fuer alte Frontend-Bundles (PWA-Cache): bis einschliesslich
# diesem Datum wird das Refresh-Token noch im Antwort-Body geliefert und im
# Request-Body akzeptiert. Danach nur Cookie. Leer = sofort beendet.
# FIELDVIBE_REFRESH_BODY_BIS=2026-12-31

# --- Reverse-Proxy / Client-IP fuer die Login-Limiter ------------------------
# Uvicorn wertet X-Forwarded-For nur von diesen Adressen/Netzen aus (Caddy im
# Compose-Netz). Default in docker-compose.prod.yml: die privaten Standard-
# Subnetze; nie "*" setzen. Ohne Proxy (lokal, .ip.yml) leer lassen.
# FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- Objektspeicher (MinIO), siehe Abschnitt 2 & 15.4 ---------------------
MINIO_ROOT_USER=fieldvibe
MINIO_ROOT_PASSWORD=changeme-generate-with-openssl-rand
# Zugang von Backend und Worker: ein MinIO-Service-Account, dessen Policy nur
# den Bucket S3_BUCKET_FOTOS erlaubt. scripts/minio-service-account.sh (von
# deploy.sh aufgerufen) erzeugt ihn und traegt beide Werte hier ein. Leer =
# Rueckfall auf MINIO_ROOT_USER/-PASSWORD (nur fuer lokale Entwicklung).
# Der Root-Zugang gehoert nur MinIO selbst und der Administration.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Statischer Master-Key fuer serverseitige Verschluesselung (SSE-S3): jeder
# Upload (Fotos, Unterschriften, Rechnungs-PDFs, DSGVO-Belege, siehe
# backend/app/services/storage_service.py:upload_bytes) fordert
# ServerSideEncryption=AES256 an -- ohne diesen Key lehnt MinIO JEDEN
# Upload mit "KMS is not configured" ab (kein optionales Feature).
# Format: <beliebiger-name>:<32-Byte-Base64-Schluessel>. Erzeugen mit:
#   printf "fieldvibe-minio:%s" "$(openssl rand -base64 32)"
MINIO_KMS_SECRET_KEY=changeme-generate-with-openssl-rand
# Server-zu-server (Docker-Netzwerk-Hostname); NICHT das, was der Browser
# aufruft -- siehe S3_PUBLIC_URL_BASE.
S3_ENDPOINT_URL=http://minio:9000
# Muss vom Browser erreichbar sein (presigned URLs). Lokal: localhost:9000.
# Produktiv: https://<DOMAIN_S3 unten>, siehe docs/DEPLOYMENT.md.
S3_PUBLIC_URL_BASE=http://localhost:9000
S3_BUCKET_FOTOS=fieldvibe-fotos
# Optional: WORM fuer archivierte Rechnungen (docs/gobd/OBJECT_LOCK.md, UNGETESTET gegen MinIO).
# S3_OBJECT_LOCK wirkt nur beim Anlegen des Buckets; S3_RECHNUNGEN_RETENTION: off | governance | compliance.
# S3_OBJECT_LOCK=false
# S3_RECHNUNGEN_RETENTION=off

# --- Produktions-Deployment (Abschnitt 15), siehe docs/DEPLOYMENT.md ------
# Nur relevant zusammen mit docker-compose.prod.yml (Caddy-Reverse-Proxy).
# Vier Subdomains auf denselben Server zeigen lassen (DNS A-Records), dann
# hier eintragen -- Caddy holt automatisch Let's-Encrypt-Zertifikate dafür.
# DOMAIN_APP = Handy/PWA, DOMAIN_OFFICE = Desktop-Oberfläche. Beide werden vom
# selben frontend-Container ausgeliefert; das Frontend entscheidet am Hostname,
# welche Oberfläche es zeigt.
DOMAIN_APP=app.example.de
DOMAIN_OFFICE=office.example.de
DOMAIN_API=api.example.de
DOMAIN_S3=s3.example.de
# Für Let's-Encrypt-Benachrichtigungen (Ablauf-/Fehlerwarnungen), nicht
# öffentlich sichtbar.
CADDY_EMAIL=admin@example.de

# --- Backups (scripts/backup.sh, per Host-Cron) --------------------------
# Ein Sicherungssatz je Lauf: Postgres-Dump (db-<stamp>.dump), MinIO-Daten
# (minio-<stamp>.tar.gz), die .env (secrets-<stamp>.tar) und ein Manifest mit
# SHA-256 (manifest-<stamp>.json). Ausfuehrliche Anleitung, Beispiele und
# Restore-Runbook: docs/DEPLOYMENT.md, Abschnitt 5.
#
# Lokales Staging-/Erstablage-Verzeichnis (immer; zusaetzliche Ziele siehe unten).
BACKUP_DIR=/opt/fieldvibe-backups
# Rotation: Saetze aelter als N Tage werden geloescht, ABER pro Ziel bleiben
# unabhaengig vom Alter immer mindestens BACKUP_MIN_KEEP vollstaendige Saetze
# (schuetzt davor, dass nach einem langen Ausfall alle Sicherungen weggeraeumt
# werden).
BACKUP_RETENTION_DAYS=14
# BACKUP_MIN_KEEP=3
#
# Backup-Ziele zusaetzlich zu BACKUP_DIR, durch Leerzeichen oder Komma getrennt,
# Eintrag = <typ>:<ziel>. Mitgelieferte Typen:
#   rclone:<remote>:<pfad>   jeder von rclone unterstuetzte Anbieter (S3, B2,
#                            Hetzner Storage Box via SFTP, WebDAV, Nextcloud, ...);
#                            Remote vorher einmalig mit "rclone config" einrichten
#   local:<verzeichnis>      zusaetzliches lokales/gemountetes Verzeichnis (NFS, USB)
#   befehl:<programm>        eigenes Programm fuer einen beliebigen Anbieter
#                            (Vertrag + Beispiel: docs/DEPLOYMENT.md,
#                            scripts/backup/ziele/befehl-beispiel.sh.example)
# Mit Leerzeichen im Wert in Anfuehrungszeichen setzen.
# BACKUP_TARGETS="rclone:hetzner:fieldvibe-backups local:/mnt/nas/fieldvibe"
# Veraltet (wird als BACKUP_TARGETS="rclone:<wert>" behandelt, wenn BACKUP_TARGETS
# leer ist): BACKUP_OFFSITE_REMOTE=hetzner-storagebox:fieldvibe-backups
#
# Verschluesselung (Art. 32 DSGVO, dringend empfohlen): Key-ID/E-Mail eines
# OFFLINE aufbewahrten oeffentlichen GPG-Schluessels. Ohne diesen Wert
#   - liegen die Sicherungen unverschluesselt auf der Platte,
#   - bleibt das Secrets-Buendel (.env) nur lokal (0600) und wird nie uebertragen,
#   - wird der Upload zu Remote-Zielen (rclone, befehl) VERWEIGERT.
# BACKUP_GPG_RECIPIENT=backup@example.de
# Nur wenn der Anbieter die Daten ausdruecklich unverschluesselt bekommen darf
# (z.B. eigenes, abgesichertes Netz). Gilt nicht fuer das Secrets-Buendel.
# BACKUP_ERLAUBE_UNVERSCHLUESSELT_REMOTE=1
#
# Ueberwachung (alles optional, aber ohne sie merkt niemand ein stilles Scheitern):
# healthchecks.io-kompatibler Ping (GET <url>/start, GET <url>, GET <url>/fail);
# fehlt der Erfolgs-Ping, schlaegt der Dienst Alarm.
# BACKUP_PING_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Eigener Ping fuer die woechentliche Pruefung (scripts/backup-pruefen.sh).
# BACKUP_PRUEF_PING_URL=https://hc-ping.com/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
# Befehl, der bei jedem Lauf (Backup und Pruefung) mit den Umgebungsvariablen
# BACKUP_STATUS=ok|fehler, BACKUP_NACHRICHT und BACKUP_STAMP aufgerufen wird
# (Mail, Telegram, ntfy ...). In EINFACHEN Anfuehrungszeichen, sonst werden die
# Variablen schon beim Einlesen der .env ersetzt.
# BACKUP_BENACHRICHTIGUNG_BEFEHL='curl -fsS -d "$BACKUP_STATUS: $BACKUP_NACHRICHT" https://ntfy.sh/mein-thema'

# --- Seed data (local dev only, see backend/app/seed.py) -----------------
SEED_SUPER_ADMIN_EMAIL=superadmin@fieldvibe.example.de
SEED_SUPER_ADMIN_PASSWORD=changeme
SEED_USER_PASSWORD=changeme

# --- Frontend ---------------------------------------------------------
# Wie der BROWSER das Backend erreicht (wird zur Build-Zeit ins JS-Bundle
# gebacken). Lokal: http://localhost:8000. Produktiv: https://<DOMAIN_API>.
VITE_API_BASE_URL=http://localhost:8000

# Links zu Impressum und Datenschutzerklaerung der Plattform (Login-,
# Registrierungs- und Passwortseiten von Mitarbeitern und Kundenportal,
# Fusszeile des Kundenportals). Ebenfalls Build-Zeit, d. h. nach einer
# Aenderung das Frontend neu bauen. Optional: Reihenfolge je Link ist
# 1. URL aus den Firmendaten des Betriebs, 2. dieser Wert, 3. die
# Platzhalter-Seite /impressum bzw. /datenschutz der App (zeigt nur die
# Firmenangaben, kein Rechtstext). Fuer den Produktivbetrieb rechtsgeprueften
# Text hinterlegen, §5 DDG/Art. 13 DSGVO.
VITE_IMPRESSUM_URL=
VITE_DATENSCHUTZ_URL=

# --- Environment ---------------------------------------------------------
# development = lokale Entwicklung: Platzhalter-Secrets sind erlaubt, die
# API-Doku (/docs, /redoc, /openapi.json) ist an, das Refresh-Cookie ohne
# Secure-Flag. Jeder andere Wert (auch ein fehlender Eintrag, Default ist
# "production") verlangt echte Secrets: Backend, Worker und Alembic brechen
# sonst beim Start mit einer Liste der unsicheren Werte ab. scripts/deploy.sh
# setzt production.
ENVIRONMENT=development
# API-Doku (/docs, /redoc, /openapi.json): Default an in Dev/Test, aus in
# Produktion. Nur zum gezielten Umschalten (1/0).
# FIELDVIBE_API_DOCS=0

# --- Angebote: Nachfassen --------------------------------------------------
# Tage nach dem Versand, nach denen der Worker den Ersteller eines noch
# unbeantworteten Angebots einmalig erinnert (zusaetzlich: Gueltigkeit laeuft
# in den naechsten 2 Tagen ab). Default 7.
# ANGEBOT_NACHFASS_TAGE=7

# --- In-App-Fehlerberichte -------------------------------------------------
# Aufbewahrung in Tagen, danach werden Berichte inkl. Screenshots geloescht.
# FIELDVIBE_FEHLERBERICHT_AUFBEWAHRUNG_TAGE=90
# sha256-Hex des Service-Tokens fuer /api/service/fehlerberichte (Claude).
# Erzeugen: docker compose run --rm backend python -m app.cli fehlerbericht-token
# Das Token selbst gehoert nur in die Claude-Umgebungsvariable
# FIELDVIBE_BUGREPORT_TOKEN. Nicht gesetzt = Service-API aus (404).
# FIELDVIBE_FEHLERBERICHT_TOKEN_HASH=

# --- Betrieb: Logs, Health, Monitoring (docs/BETRIEB.md) ----------------------
# Log-Format: json (Standard ausser in Dev) oder text. Jede Zeile traegt die
# Request-ID (Antwort-Header X-Request-ID) sowie mandant_id/user_id, nie Tokens
# oder Bodies.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
