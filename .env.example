# Copy to .env and fill in real values. Never commit the real .env file.
# chmod 600 .env in production.

# --- Postgres ---------------------------------------------------------
POSTGRES_USER=socialcrm
POSTGRES_PASSWORD=changeme-generate-with-openssl-rand
POSTGRES_DB=socialcrm

# Used by the backend container (service name "postgres" inside compose network)
DATABASE_URL=postgresql+asyncpg://socialcrm:changeme-generate-with-openssl-rand@postgres:5432/socialcrm
DATABASE_URL_SYNC=postgresql+psycopg2://socialcrm:changeme-generate-with-openssl-rand@postgres:5432/socialcrm

# --- Auth ---------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme-generate-with-openssl-rand
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=20160
IMPERSONATION_TOKEN_EXPIRE_MINUTES=60

# --- CORS -----------------------------------------------------------------
# Comma-separated list is not supported by pydantic-settings list parsing via
# env directly; use a JSON array string, e.g. '["https://app.example.de"]'
CORS_ORIGINS=["http://localhost:5173"]

# --- Seed data (local dev only, see backend/app/seed.py) -----------------
SEED_SUPER_ADMIN_EMAIL=superadmin@socialcrm.local
SEED_SUPER_ADMIN_PASSWORD=changeme
SEED_USER_PASSWORD=changeme

# --- Frontend ---------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# --- Environment ---------------------------------------------------------
ENVIRONMENT=development
